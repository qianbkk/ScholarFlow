# ===== LLM Provider API Keys =====
# Anthropic-compatible providers (MiniMax / Kimi / GLM / Aliyun)
# All providers below expose an Anthropic Messages-compatible API.
# Pick the one(s) you have access to; the rest can stay empty.
#
# ===== 默认 provider =====
# MiniMax 是默认测试 provider — 国内直连, 性价比高.
# 把 LLM_PROVIDER 设为 minimax (或其他填了 key 的 provider) 即可切换.
# 如果 .env 没配任何 *_API_KEY, 走 LLM_MOCK=true 自动回退 (backend/config.py 兜底).

# MiniMax (Anthropic-compatible) — 默认测试 provider
MiniMax_API_KEY=
MiniMax_BASE_URL=https://api.minimaxi.com/anthropic
MiniMax_MODEL=MiniMax-M3
MiniMax_FAST_MODEL=MiniMax-M2.7

# Kimi / Moonshot (Anthropic-compatible)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/anthropic
KIMI_MODEL=kimi-k2.6
KIMI_FAST_MODEL=kimi-k2.5

# GLM / Zhipu AI (Anthropic-compatible)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
GLM_MODEL=glm-5.1
GLM_FAST_MODEL=glm-6

# Anthropic (official, needs VPN)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Fix-X4: 模型可配置 (Anthropic 4.x 弃用时改 .env 即可, 不需改源码)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# DeepSeek (placeholder, will gracefully degrade if empty)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== Academic API Keys =====
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=your-email@example.com

# ===== Runtime Configuration =====
# R10 (M-16): 默认 provider 改成 minimax (项目所有者偏好).
# 也可手动切到 kimi / glm / anthropic / deepseek (只要该 provider 有 API key).
LLM_PROVIDER=minimax

# Budget cap per search (USD)
BUDGET_LIMIT_USD=2.0

# Max adaptive query-rewrite iterations
MAX_SEARCH_ITERATIONS=3

# ===== Proxy (国内直连 SS / OpenAlex 经常需要) =====
# httpx 默认不读 env，必须显式配置。
# 取消下面这行的注释并填入你的代理地址。
# HTTPS_PROXY=http://127.0.0.1:7890

# ===== Mock 模式 (无网络或演示用) =====
# LLM_MOCK=true   # 使用 mock LLM（无 token 消耗）
# API_MOCK=true   # 使用 mock 学术 API（55 篇内置论文）

# ===== 服务端网络/安全配置 (R10.5) =====
# 允许的 Host 头 (逗号分隔), 生产必须设防 Host header 注入
# 开发期默认 * (所有 host), 生产设 e.g. scholarflow.example.com,api.scholarflow.example.com
# ALLOWED_HOSTS=*

# 生产设 false 关闭 /docs + /openapi.json 防 schema 枚举攻击
EXPOSE_DOCS=true

# SQLite 三类表 (search_cache / budget / users) 强制分文件目录
# 不设则共用 backend/.cache/search_cache.sqlite, 多 worker 并发写会争锁
# K8s 部署推荐: SCHOLARFLOW_DB_DIR=/data
# SCHOLARFLOW_DB_DIR=

# true 时每次新建 httpx client (仅调试用, 默认 false)
# DISABLE_HTTP_POOL=false

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== Mock / real 模式切换 =====
# 至少一个 LLM key 配置后 LLM_MOCK 自动关闭；API_MOCK=true 时学术 API 也走 mock
LLM_MOCK=true
API_MOCK=true

# ===== R10.5 Fix-P0-B: 多用户 + API Key 认证 =====
# OPEN_MODE=true 时跳过 X-API-Key 校验, 所有请求走虚拟 "dev-user".
# 本地开发 / 跑测试时设 true; 高校部署 (Docker / k8s) 必设 false.
OPEN_MODE=true
# Per-user 每小时预算上限 (USD), 多用户模式生效. OPEN_MODE 模式
# dev-user 仍走 GLOBAL_HOURLY_BUDGET.
# PER_USER_HOURLY_BUDGET=5.0

# ===== CORS =====
# 允许的前端 origin（逗号分隔）。开发环境默认 localhost:5173 / :3000；
# 生产环境设为你的真实域名，例如：
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ===== 成本控制 =====
GLOBAL_HOURLY_BUDGET=50.0
ENABLE_SEARCH_CACHE=true
CACHE_TTL_SECONDS=86400

# R10.5 推荐: K8s Secret 注入 OPEN_MODE=false + 真 key, 不要走 ConfigMap 明文
